<!DOCTYPE html>
<html lang="en" dir="ltr" id="html-root">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>UrLife — Where Minds Meet</title>
<link rel="manifest" href="./manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0B0B0B">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: https:; frame-ancestors 'none';">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   TOKENS & RESET
═══════════════════════════════════════ */
:root {
  --bg:       #0b0b0b;
  --bg2:      #050505;
  --surface:  #141414;
  --lift:     #0f0f0f;
  --card:     rgba(255,255,255,.038);
  --gold:     #a86b2e;
  --gold2:    #d0ba86;
  --goldf:    rgba(212,175,55,0.10);
  --goldl:    rgba(212,175,55,0.18);
  --ember:    #ff3820;
  --emberf:   rgba(255,56,32,.1);
  --sky:      #d4af37;
  --mint:     #e5590e;
  --white:    #f5f5f5;
  --dim:      rgba(245,245,245,0.45);
  --border:   rgba(255,255,255,.07);
  --r:8px; --r2:16px; --r3:24px;
  --font-en:  'Clash Display', sans-serif;
  --font-body-en: 'Satoshi', sans-serif;
  --font-ar:  'Cairo', sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{scroll-behavior:smooth;font-size:16px;}
body{
  font-family:var(--font-body-en);
  background:var(--bg);color:var(--white);
  overflow-x:hidden;line-height:1.6;
}
[lang="ar"] body, .ar body{
  font-family:var(--font-ar);
  direction:rtl;
}

/* ═══════════════════════════════════════
   3D CANVAS BACKGROUND
═══════════════════════════════════════ */
#canvas3d{
  position:fixed;top:0;left:0;width:100%;height:100%;
  z-index:0;pointer-events:none;opacity:.7;
}
.page-wrap{position:relative;z-index:1;}

/* ═══════════════════════════════════════
   CUSTOM CURSOR — DESKTOP ONLY
═══════════════════════════════════════ */
@media(hover:hover) and (pointer:fine){
  *{cursor:auto!important;}
  a,button,[role="button"]{cursor:pointer!important;}
  #cur{
    position:fixed;top:0;left:0;width:14px;height:14px;
    pointer-events:none;z-index:9999;will-change:transform;
    transform:translate3d(-200vw,0,0);
    filter:drop-shadow(0 0 4px var(--gold-vivid,#d4af37)) drop-shadow(0 0 8px rgba(212,175,55,0.4));
    transition:filter 0.25s;
  }
  #cur.cursor--hover{filter:drop-shadow(0 0 8px var(--gold-vivid,#d4af37)) drop-shadow(0 0 16px rgba(212,175,55,0.65));}
  #cur-ring{
    position:fixed;top:0;left:0;width:28px;height:28px;border-radius:50%;
    background:radial-gradient(circle,rgba(212,175,55,0.35) 0%,transparent 70%);
    pointer-events:none;z-index:9998;will-change:transform;opacity:0.35;
    transform:translate3d(-200vw,0,0);
  }
}
@media(hover:none),(pointer:coarse){#cur,#cur-ring{display:none!important;}}
@media(prefers-reduced-motion:reduce){#cur-ring{display:none;}#cur{transition:none;}}

/* ═══════════════════════════════════════
   NAVIGATION
═══════════════════════════════════════ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:500;
  padding:16px 48px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(2,4,10,.92);
  backdrop-filter:blur(28px) saturate(180%);
  border-bottom:1px solid var(--border);
  transition:padding .3s;
}
.nav-logo{
  font-family:var(--font-en);
  font-size:22px;font-weight:700;
  letter-spacing:-1px;color:var(--white);
  flex-shrink:0;
}
.nav-logo em{color:var(--ember);font-style:normal;}
.nav-links{display:flex;align-items:center;gap:28px;}
.nav-links a{
  font-size:13px;color:var(--dim);
  text-decoration:none;letter-spacing:.5px;
  transition:color .2s;white-space:nowrap;
}
.nav-links a:hover{color:var(--white);}
.nav-right{display:flex;align-items:center;gap:10px;}
.lang-btn{
  background:var(--goldf);
  border:1px solid var(--goldl);
  color:var(--gold2);
  font-family:var(--font-body-en);
  font-size:12px;font-weight:600;
  padding:8px 16px;border-radius:30px;
  letter-spacing:1px;transition:all .3s;
  white-space:nowrap;
}
.lang-btn:hover{background:var(--gold);color:var(--bg);}
.nav-cta{
  background:var(--gold);color:var(--bg);
  font-family:var(--font-body-en);
  font-size:13px;font-weight:700;
  padding:9px 20px;border-radius:8px;border:none;
  letter-spacing:.5px;transition:all .3s;
  white-space:nowrap;
}
.nav-cta:hover{background:var(--gold2);}

/* Hamburger */
.nav-burger{
  display:none;
  flex-direction:column;gap:5px;
  background:none;border:none;padding:8px;
  cursor:pointer!important;z-index:600;
}
.nav-burger span{
  display:block;width:24px;height:2px;
  background:var(--white);border-radius:2px;
  transition:all .3s;
}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.nav-burger.open span:nth-child(2){opacity:0;}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

/* Mobile drawer */
.nav-drawer{
  display:none;
  position:fixed;top:0;left:0;right:0;bottom:0;
  background:rgba(2,4,10,.97);
  backdrop-filter:blur(30px);
  z-index:490;
  flex-direction:column;align-items:center;justify-content:center;
  gap:0;
  opacity:0;pointer-events:none;
  transition:opacity .3s ease;
}
.nav-drawer.open{opacity:1;pointer-events:all;}
.nav-drawer a{
  font-family:var(--font-en);
  font-size:28px;font-weight:700;
  color:var(--dim);text-decoration:none;
  padding:18px 0;letter-spacing:-1px;
  transition:color .2s;
  border-bottom:1px solid var(--border);
  width:80%;text-align:center;
}
.nav-drawer a:hover{color:var(--gold2);}
.nav-drawer a:last-child{border:none;}
.nav-drawer .drawer-actions{
  display:flex;gap:12px;margin-top:32px;flex-wrap:wrap;justify-content:center;
}
html[dir="rtl"] .nav-drawer a{font-family:var(--font-ar);letter-spacing:0;}

/* ═══════════════════════════════════════
   HERO
═══════════════════════════════════════ */
.hero{
  min-height:100vh;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  text-align:center;
  padding:130px 40px 100px;
  position:relative;overflow:hidden;
}
.hero-orb{
  position:absolute;border-radius:50%;
  pointer-events:none;
}
.hero-orb-1{
  width:700px;height:700px;
  background:radial-gradient(circle,rgba(200,148,42,.06),transparent 70%);
  top:50%;left:50%;transform:translate(-50%,-55%);
  animation:orb1 8s ease-in-out infinite;
}
.hero-orb-2{
  width:400px;height:400px;
  background:radial-gradient(circle,rgba(255,56,32,.05),transparent 70%);
  bottom:-100px;right:-100px;
  animation:orb2 12s ease-in-out infinite;
}
@keyframes orb1{0%,100%{transform:translate(-50%,-55%) scale(1);}50%{transform:translate(-50%,-50%) scale(1.08);}}
@keyframes orb2{0%,100%{transform:scale(1);}50%{transform:scale(1.2) translate(-20px,-20px);}}

/* 3D rotating rings */
.hero-rings{
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  pointer-events:none;width:900px;height:900px;
}
.ring{
  position:absolute;top:50%;left:50%;
  border:1px solid rgba(200,148,42,.06);
  border-radius:50%;transform-origin:center;
}
.ring-1{width:400px;height:400px;margin:-200px 0 0 -200px;animation:ringR1 20s linear infinite;border-color:rgba(200,148,42,.08);}
.ring-2{width:600px;height:600px;margin:-300px 0 0 -300px;animation:ringR2 30s linear infinite reverse;border-style:dashed;}
.ring-3{width:800px;height:800px;margin:-400px 0 0 -400px;animation:ringR3 45s linear infinite;border-color:rgba(200,148,42,.04);}
@keyframes ringR1{to{transform:rotate(360deg) rotateX(70deg);}}
@keyframes ringR2{to{transform:rotate(360deg) rotateY(60deg);}}
@keyframes ringR3{to{transform:rotate(-360deg) rotateX(40deg) rotateY(30deg);}}

.hero-tag{
  display:inline-flex;align-items:center;gap:10px;
  border:1px solid var(--goldl);
  background:var(--goldf);
  color:var(--gold2);font-size:11px;
  font-family:var(--font-body-en);
  letter-spacing:3px;text-transform:uppercase;
  padding:9px 22px;border-radius:40px;
  margin-bottom:44px;position:relative;z-index:1;
  animation:fadeUp .8s ease both;
}
.hero-tag .dot{
  width:6px;height:6px;background:var(--gold);
  border-radius:50%;animation:pulse 2s ease infinite;
}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(200,148,42,.5);}50%{box-shadow:0 0 0 8px rgba(200,148,42,0);}}

h1.htitle{
  font-family:var(--font-en);
  font-size:clamp(56px,10vw,128px);
  font-weight:700;line-height:.88;
  letter-spacing:-4px;
  margin-bottom:36px;
  position:relative;z-index:1;
  animation:fadeUp .9s .1s ease both;
}
.htitle .l1{display:block;color:var(--white);}
.htitle .l2{
  display:block;
  background:linear-gradient(135deg,var(--gold),var(--gold2),var(--ember));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.htitle .l3{
  display:block;
  color:transparent;
  -webkit-text-stroke:1.5px rgba(200,148,42,.25);
  letter-spacing:-2px;
}

.hero-desc{
  max-width:680px;font-size:clamp(16px,2vw,20px);
  color:var(--dim);line-height:1.85;
  margin:0 auto 56px;
  position:relative;z-index:1;
  animation:fadeUp .9s .2s ease both;
}
.hero-desc strong{color:var(--white);font-weight:600;}

.hero-btns{
  display:flex;gap:14px;justify-content:center;flex-wrap:wrap;
  position:relative;z-index:1;
  animation:fadeUp .9s .3s ease both;
}
.btn-primary{
  background:var(--gold);color:var(--bg);
  font-family:var(--font-body-en);font-size:15px;font-weight:700;
  padding:16px 42px;border-radius:10px;border:none;
  letter-spacing:.3px;transition:all .35s;
  position:relative;overflow:hidden;
}
.btn-primary::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,.15),transparent);
  opacity:0;transition:opacity .3s;
}
.btn-primary:hover{background:var(--gold2);transform:translateY(-4px);box-shadow:0 24px 60px rgba(200,148,42,.28);}
.btn-primary:hover::after{opacity:1;}
.btn-outline{
  background:transparent;color:var(--white);
  font-family:var(--font-body-en);font-size:15px;font-weight:600;
  padding:16px 42px;border-radius:10px;
  border:1px solid rgba(255,255,255,.12);transition:all .3s;
}
.btn-outline:hover{border-color:var(--goldl);color:var(--gold2);}

.hero-stats{
  display:flex;gap:0;margin-top:90px;
  border:1px solid var(--border);border-radius:20px;overflow:hidden;
  position:relative;z-index:1;
  animation:fadeUp .9s .4s ease both;
  background:rgba(255,255,255,.02);
  backdrop-filter:blur(10px);
}
.hstat{
  padding:28px 44px;text-align:center;
  border-right:1px solid var(--border);flex:1;
  transition:background .3s;
}
.hstat:last-child{border-right:none;}
.hstat:hover{background:rgba(255,255,255,.03);}
.hstat-v{
  font-family:var(--font-en);
  font-size:38px;font-weight:700;
  color:var(--gold2);display:block;line-height:1;
  letter-spacing:-1px;
}
.hstat-l{font-size:12px;color:var(--dim);margin-top:6px;letter-spacing:.5px;}

/* ═══════════════════════════════════════
   SECTION BASE
═══════════════════════════════════════ */
.section{
  padding:100px 60px;
  max-width:1240px;margin:0 auto;
  position:relative;z-index:1;
}
.sec-chip{
  display:inline-flex;align-items:center;gap:8px;
  font-size:10px;font-family:var(--font-body-en);
  color:var(--ember);letter-spacing:4px;
  text-transform:uppercase;font-weight:700;
  margin-bottom:22px;
}
.sec-chip::before{content:'';width:24px;height:1.5px;background:var(--ember);}
h2.sec-title{
  font-family:var(--font-en);
  font-size:clamp(30px,4.5vw,58px);
  font-weight:700;letter-spacing:-2px;
  line-height:1.05;margin-bottom:20px;
}
h2.sec-title .g{
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
h2.sec-title .e{color:var(--ember);}
.sec-body{font-size:17px;color:var(--dim);max-width:620px;line-height:1.85;}

.divline{
  height:1px;margin:0 60px;
  background:linear-gradient(to right,transparent,var(--border) 25%,var(--border) 75%,transparent);
}

/* ═══════════════════════════════════════
   3D PROCESS FLOW
═══════════════════════════════════════ */
.process{margin-top:70px;position:relative;}
.process-track{
  position:absolute;top:36px;left:36px;right:36px;height:2px;
  background:linear-gradient(to right,var(--gold),var(--ember));
  opacity:.2;
}
.process-steps{
  display:grid;grid-template-columns:repeat(5,1fr);
  gap:16px;position:relative;z-index:1;
}
.ps{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:20px;padding:32px 22px;
  text-align:center;
  transition:all .4s cubic-bezier(.175,.885,.32,1.275);
  position:relative;overflow:hidden;
  transform:translateZ(0);
}
.ps::before{
  content:'';position:absolute;inset:0;border-radius:20px;
  background:linear-gradient(135deg,rgba(200,148,42,.06),transparent);
  opacity:0;transition:opacity .3s;
}
.ps:hover{
  transform:translateY(-12px) scale(1.02);
  border-color:var(--goldl);
  box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 0 1px rgba(200,148,42,.15),inset 0 1px 0 rgba(255,255,255,.08);
}
.ps:hover::before{opacity:1;}
.ps-num{
  font-family:var(--font-en);font-size:11px;font-weight:700;
  color:var(--ember);letter-spacing:3px;margin-bottom:20px;
  display:block;
}
.ps-ico{
  width:64px;height:64px;border-radius:16px;
  background:var(--goldf);border:1px solid var(--goldl);
  display:flex;align-items:center;justify-content:center;
  font-size:28px;margin:0 auto 20px;
  transition:transform .3s;
}
.ps:hover .ps-ico{transform:scale(1.1) rotate(-5deg);}
.ps h3{font-size:15px;font-weight:600;color:var(--white);margin-bottom:10px;}
.ps p{font-size:12px;color:var(--dim);line-height:1.7;}
.ps-time{
  display:inline-block;margin-top:14px;
  font-size:10px;background:rgba(255,255,255,.05);
  border:1px solid var(--border);
  color:var(--dim);padding:4px 12px;border-radius:20px;
}

/* ═══════════════════════════════════════
   ROLES — 3D CARDS
═══════════════════════════════════════ */
.roles-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:20px;margin-top:70px;
  perspective:1000px;
}
.role-card{
  border-radius:24px;padding:44px 36px;
  position:relative;overflow:hidden;
  transition:all .5s cubic-bezier(.23,1,.32,1);
  transform-style:preserve-3d;
  cursor:default;
}
.role-card::after{
  content:'';position:absolute;
  top:-50%;right:-50%;width:200%;height:200%;
  background:radial-gradient(circle at 70% 30%,rgba(255,255,255,.03),transparent 50%);
  pointer-events:none;
}
.role-card:hover{transform:translateY(-10px) rotateX(4deg) rotateY(-3deg);box-shadow:0 40px 100px rgba(0,0,0,.6);}
.rc-gold{background:linear-gradient(145deg,rgba(200,148,42,.12),rgba(200,148,42,.03));border:1px solid rgba(200,148,42,.22);}
.rc-sky{background:linear-gradient(145deg,rgba(212,175,55,.08),rgba(212,175,55,.02));border:1px solid rgba(212,175,55,.22);}
.rc-mint{background:linear-gradient(145deg,rgba(0,212,160,.08),rgba(0,212,160,.02));border:1px solid rgba(0,212,160,.15);}
.rc-num{
  font-family:var(--font-en);font-size:100px;font-weight:700;
  position:absolute;top:-10px;right:20px;
  opacity:.04;line-height:1;letter-spacing:-4px;
}
.rc-ico{font-size:44px;margin-bottom:22px;display:block;}
.role-card h3{font-size:22px;font-weight:700;margin-bottom:12px;font-family:var(--font-en);}
.rc-gold h3{color:var(--gold2);}
.rc-sky h3{color:var(--sky);}
.rc-mint h3{color:var(--mint);}
.role-card p{font-size:14px;color:var(--dim);line-height:1.8;margin-bottom:24px;}
.rc-list{list-style:none;}
.rc-list li{
  font-size:13px;color:rgba(237,241,255,.55);
  padding:8px 0;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.rc-list li:last-child{border:none;}
.rc-list li::before{content:'→';font-size:11px;flex-shrink:0;}
.rc-gold .rc-list li::before{color:var(--gold);}
.rc-sky .rc-list li::before{color:var(--sky);}
.rc-mint .rc-list li::before{color:var(--mint);}

/* ═══════════════════════════════════════
   CLOSED MEETING — GLASS MORPHISM
═══════════════════════════════════════ */
.meeting-box{
  margin-top:70px;
  border-radius:28px;overflow:hidden;
  border:1px solid var(--border);
  background:rgba(255,255,255,.02);
  backdrop-filter:blur(20px);
  box-shadow:0 50px 120px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.06);
}
.mb-top{
  padding:36px 48px;
  background:linear-gradient(135deg,rgba(200,148,42,.07),transparent);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.mb-top h3{font-family:var(--font-en);font-size:22px;font-weight:700;}
.restricted{
  background:var(--emberf);border:1px solid rgba(255,56,32,.25);
  color:var(--ember);font-size:11px;padding:7px 16px;
  border-radius:20px;font-weight:700;letter-spacing:2px;
}
.mb-flow{
  padding:52px 48px;
  display:grid;grid-template-columns:repeat(5,1fr);
  gap:16px;position:relative;
}
.mb-flow::before{
  content:'';position:absolute;
  top:88px;left:60px;right:60px;height:1px;
  background:linear-gradient(to right,var(--gold),var(--ember));
  opacity:.25;
}
.mbs{text-align:center;position:relative;z-index:1;}
.mbs-ico{
  width:52px;height:52px;border-radius:14px;
  background:var(--surface);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;margin:0 auto 16px;
  transition:all .3s;
}
.mbs:hover .mbs-ico{border-color:var(--goldl);background:var(--goldf);transform:scale(1.1);}
.mbs h4{font-size:13px;font-weight:600;color:var(--white);margin-bottom:8px;}
.mbs p{font-size:11px;color:var(--dim);line-height:1.6;}
.mb-note{
  padding:24px 48px;border-top:1px solid var(--border);
  background:var(--goldf);
  font-size:14px;color:var(--dim);
}
.mb-note strong{color:var(--gold2);}

/* ═══════════════════════════════════════
   REVENUE MODEL
═══════════════════════════════════════ */
.rev-grid{
  display:grid;
  grid-template-columns:1.5fr 1fr 1fr;
  gap:20px;margin-top:70px;
}
.rev-card{
  border-radius:22px;padding:40px;
  transition:all .4s;
}
.rev-card:hover{transform:translateY(-6px);}
.rev-main{
  background:linear-gradient(145deg,rgba(200,148,42,.1),rgba(200,148,42,.03));
  border:1px solid rgba(200,148,42,.22);
  grid-row:span 2;
}
.rev-side{
  background:var(--card);border:1px solid var(--border);
}
.rev-ico{font-size:38px;margin-bottom:22px;}
.rev-card h3{font-family:var(--font-en);font-size:19px;font-weight:700;margin-bottom:10px;}
.rev-main h3{color:var(--gold2);}
.rev-side h3{color:var(--white);}
.rev-card p{font-size:13px;color:var(--dim);line-height:1.8;margin-bottom:20px;}
.rev-num{font-family:var(--font-en);font-size:36px;font-weight:700;color:var(--gold);letter-spacing:-1px;}
.rev-num-l{font-size:12px;color:var(--dim);margin-top:4px;}
.rev-list{list-style:none;margin-top:18px;}
.rev-list li{
  font-size:12px;color:rgba(237,241,255,.5);
  padding:7px 0;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:8px;
}
.rev-list li:last-child{border:none;}
.rev-list li::before{content:'▸';color:var(--gold);font-size:10px;}
.rev-pill{
  display:inline-block;margin-top:14px;
  font-size:11px;background:var(--emberf);
  border:1px solid rgba(255,56,32,.2);
  color:var(--ember);padding:5px 14px;border-radius:20px;font-weight:700;
}

/* ═══════════════════════════════════════
   INVESTORS SECTION
═══════════════════════════════════════ */
.inv-box{
  margin-top:50px;
  background:linear-gradient(135deg,rgba(59,143,255,.07),rgba(0,212,160,.04));
  border:1px solid rgba(59,143,255,.14);
  border-radius:22px;padding:48px;
  display:grid;grid-template-columns:1fr auto;
  gap:50px;align-items:center;
}
.inv-box h3{font-family:var(--font-en);font-size:24px;font-weight:700;margin-bottom:14px;}
.inv-box p{font-size:15px;color:var(--dim);line-height:1.8;margin-bottom:24px;}
.inv-tags{display:flex;gap:10px;flex-wrap:wrap;}
.inv-tag{
  background:rgba(255,255,255,.05);border:1px solid var(--border);
  font-size:12px;color:var(--white);padding:7px 16px;border-radius:20px;
  transition:all .3s;
}
.inv-tag:hover{border-color:var(--goldl);color:var(--gold2);}
.inv-stat{text-align:center;flex-shrink:0;}
.inv-val{font-family:var(--font-en);font-size:56px;font-weight:700;color:var(--sky);line-height:1;letter-spacing:-2px;}
.inv-label{font-size:12px;color:var(--dim);margin-top:8px;}

/* ═══════════════════════════════════════
   AI LAYER
═══════════════════════════════════════ */
.ai-panel{
  margin-top:70px;border-radius:24px;overflow:hidden;
  border:1px solid var(--border);
  background:rgba(255,255,255,.02);
}
.ai-head{
  padding:30px 44px;border-bottom:1px solid var(--border);
  background:linear-gradient(135deg,rgba(200,148,42,.05),transparent);
  display:flex;align-items:center;justify-content:space-between;
}
.ai-head h3{font-family:var(--font-en);font-size:20px;font-weight:700;color:var(--gold2);}
.ai-badge{
  background:var(--goldf);border:1px solid var(--goldl);
  color:var(--gold);font-size:11px;padding:6px 14px;
  border-radius:20px;font-weight:700;letter-spacing:1px;
}
.ai-features{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:0;
}
.aif{
  padding:32px 28px;border-left:1px solid var(--border);
  transition:background .2s;
}
.aif:first-child{border-left:none;}
.aif:hover{background:rgba(255,255,255,.025);}
.aif-ico{width:36px;height:36px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;}
.aif h4{font-size:14px;font-weight:600;color:var(--white);margin-bottom:8px;}
.aif p{font-size:12px;color:var(--dim);line-height:1.7;}
.ai-footer{
  padding:22px 44px;border-top:1px solid var(--border);
  font-size:13px;color:var(--dim);
  background:var(--goldf);
}
.ai-footer strong{color:var(--gold2);}

/* ═══════════════════════════════════════
   ROADMAP — HORIZONTAL TIMELINE
═══════════════════════════════════════ */
.roadmap{
  margin-top:70px;display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid var(--border);border-radius:22px;overflow:hidden;
}
.rm{
  padding:36px 28px;border-right:1px solid var(--border);
  position:relative;transition:background .3s;
}
.rm:last-child{border-right:none;}
.rm:hover{background:rgba(255,255,255,.025);}
.rm-n{
  font-family:var(--font-en);font-size:80px;font-weight:700;
  color:rgba(200,148,42,.05);position:absolute;
  top:8px;right:16px;line-height:1;letter-spacing:-3px;
}
.rm-when{font-size:10px;color:var(--ember);letter-spacing:3px;font-weight:700;margin-bottom:14px;}
.rm h4{font-family:var(--font-en);font-size:17px;font-weight:700;color:var(--gold2);margin-bottom:10px;}
.rm p{font-size:12px;color:var(--dim);line-height:1.7;}
.rm-kpi{
  margin-top:16px;padding:10px 14px;
  background:var(--goldf);border:1px solid var(--goldl);
  border-radius:8px;font-size:11px;color:var(--gold);font-weight:700;
}

/* ═══════════════════════════════════════
   MANIFESTO — CINEMATIC
═══════════════════════════════════════ */
.manifesto{
  padding:140px 60px;text-align:center;
  position:relative;overflow:hidden;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  background:radial-gradient(ellipse at 50% 50%,rgba(200,148,42,.07),transparent 70%);
}
.manifesto-watermark{
  position:absolute;inset:0;display:flex;
  align-items:center;justify-content:center;
  font-family:var(--font-en);font-size:280px;font-weight:700;
  color:rgba(200,148,42,.016);pointer-events:none;
  letter-spacing:-10px;line-height:1;
  white-space:nowrap;
}
.manifesto blockquote{
  font-family:var(--font-en);
  font-size:clamp(22px,4vw,50px);
  font-weight:700;line-height:1.3;
  color:var(--white);max-width:980px;
  margin:0 auto 28px;
  position:relative;z-index:1;
  letter-spacing:-1px;
}
.manifesto blockquote .g{
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.manifesto blockquote .e{color:var(--ember);}
.manifesto-sub{
  font-size:17px;color:var(--dim);
  max-width:580px;margin:0 auto;
  position:relative;z-index:1;
}

/* ═══════════════════════════════════════
   TECH STACK
═══════════════════════════════════════ */
.tech-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:12px;margin-top:52px;
}
.tech-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:20px;
  display:flex;align-items:center;gap:14px;
  transition:all .3s;
}
.tech-card:hover{border-color:var(--goldl);background:var(--goldf);transform:translateY(-3px);}
.tc-ico{width:26px;height:26px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
.tc-name{font-size:14px;font-weight:600;color:var(--white);}
.tc-role{font-size:11px;color:var(--dim);margin-top:2px;}

/* ═══════════════════════════════════════
   FINAL CTA
═══════════════════════════════════════ */
.fcta{
  padding:160px 60px;text-align:center;
  background:radial-gradient(ellipse at 50% 0%,rgba(200,148,42,.09),transparent 60%);
  position:relative;z-index:1;
}
.fcta h2{
  font-family:var(--font-en);
  font-size:clamp(44px,8vw,96px);
  font-weight:700;letter-spacing:-4px;
  line-height:.92;margin-bottom:30px;
}
.fcta h2 span{
  background:linear-gradient(135deg,var(--gold),var(--gold2),var(--ember));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.fcta p{font-size:18px;color:var(--dim);max-width:580px;margin:0 auto 52px;line-height:1.8;}
.fcta-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}

footer{
  text-align:center;padding:56px 60px;
  border-top:1px solid var(--border);
  color:var(--dim);font-size:13px;
  position:relative;z-index:1;
}
.f-logo{
  font-family:var(--font-en);font-size:32px;font-weight:700;
  color:var(--white);margin-bottom:12px;letter-spacing:-1px;
}
.f-logo em{color:var(--ember);font-style:normal;}
.f-tagline{color:var(--dim);font-size:14px;margin-bottom:20px;}
.f-meta{font-size:11px;opacity:.35;letter-spacing:3px;text-transform:uppercase;margin-top:10px;}

/* ═══════════════════════════════════════
   SCROLL REVEAL
═══════════════════════════════════════ */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .8s ease,transform .8s ease;}
.reveal.in{opacity:1;transform:translateY(0);}
.reveal-scale{opacity:0;transform:scale(.95);transition:opacity .7s ease,transform .7s ease;}
.reveal-scale.in{opacity:1;transform:scale(1);}

/* ═══════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════ */
@keyframes fadeUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}

/* ═══════════════════════════════════════
   ARABIC OVERRIDES
═══════════════════════════════════════ */
html[dir="rtl"] .sec-chip::before{display:none;}
html[dir="rtl"] .sec-chip::after{content:'';width:24px;height:1.5px;background:var(--ember);}
html[dir="rtl"] .process-track{background:linear-gradient(to left,var(--gold),var(--ember));}
html[dir="rtl"] .mb-flow::before{background:linear-gradient(to left,var(--gold),var(--ember));}
html[dir="rtl"] h1.htitle,
html[dir="rtl"] h2.sec-title,
html[dir="rtl"] .rev-card h3,
html[dir="rtl"] .role-card h3,
html[dir="rtl"] .rm h4,
html[dir="rtl"] .fcta h2,
html[dir="rtl"] .manifesto blockquote,
html[dir="rtl"] .f-logo,
html[dir="rtl"] .ai-head h3,
html[dir="rtl"] .mb-top h3,
html[dir="rtl"] .inv-box h3{font-family:var(--font-ar);}
html[dir="rtl"] nav .nav-links a,
html[dir="rtl"] .btn-primary,
html[dir="rtl"] .btn-outline,
html[dir="rtl"] .nav-cta{font-family:var(--font-ar);}
html[dir="rtl"] .inv-val{letter-spacing:0;}

/* ═══════════════════════════════════════
   RESPONSIVE — TABLET 1024px
═══════════════════════════════════════ */
@media(max-width:1024px){
  nav{padding:14px 24px;}
  .nav-links{display:none;}
  .nav-cta{display:none;}
  .nav-burger{display:flex;}
  .nav-drawer{display:flex;}
  .section{padding:70px 28px;}
  .divline{margin:0 28px;}
  .roles-grid{grid-template-columns:1fr 1fr;}
  .rev-grid{grid-template-columns:1fr 1fr;}
  .rev-main{grid-row:auto;grid-column:1/-1;}
  .ai-features{grid-template-columns:1fr 1fr;}
  .roadmap{grid-template-columns:1fr 1fr;}
  .rm:nth-child(2){border-right:none;}
  .rm:nth-child(3){border-top:1px solid var(--border);border-right:1px solid var(--border);}
  .rm:nth-child(4){border-top:1px solid var(--border);border-right:none;}
  .process-steps{grid-template-columns:1fr 1fr;}
  .process-track{display:none;}
  .mb-flow{grid-template-columns:1fr 1fr;padding:36px 28px;}
  .mb-flow::before{display:none;}
  .inv-box{grid-template-columns:1fr;}
  .inv-stat{text-align:left;}
  html[dir="rtl"] .inv-stat{text-align:right;}
  .manifesto{padding:80px 28px;}
  .fcta{padding:80px 28px;}
  footer{padding:40px 28px;}
  .hero-rings{width:400px;height:400px;}
  .hero{padding:110px 28px 80px;}
  .hero-stats{max-width:100%;}
}

/* ═══════════════════════════════════════
   RESPONSIVE — MOBILE 600px
═══════════════════════════════════════ */
@media(max-width:600px){
  /* NAV */
  nav{padding:14px 20px;}
  .nav-logo{font-size:20px;}

  /* CANVAS — reduce nodes for perf */
  #canvas3d{opacity:.4;}

  /* HERO */
  .hero{padding:100px 20px 60px;min-height:100svh;}
  .hero-orb-1{width:300px;height:300px;}
  .hero-orb-2{width:200px;height:200px;}
  .hero-rings{width:280px;height:280px;}
  .ring-1{width:180px;height:180px;margin:-90px 0 0 -90px;}
  .ring-2{width:250px;height:250px;margin:-125px 0 0 -125px;}
  .ring-3{width:320px;height:320px;margin:-160px 0 0 -160px;}
  .hero-tag{font-size:10px;padding:8px 16px;letter-spacing:2px;margin-bottom:28px;}
  h1.htitle{letter-spacing:-2px;margin-bottom:24px;}
  .hero-desc{font-size:15px;margin-bottom:36px;}
  .hero-btns{gap:10px;}
  .btn-primary,.btn-outline{
    width:100%;font-size:15px;
    padding:16px 24px;text-align:center;
  }
  .hero-stats{
    display:grid;grid-template-columns:1fr 1fr;
    border:1px solid var(--border);border-radius:16px;
    margin-top:40px;overflow:hidden;
  }
  .hstat{padding:20px 16px;border-right:1px solid var(--border);border-bottom:1px solid var(--border);}
  .hstat:nth-child(2){border-right:none;}
  .hstat:nth-child(3){border-bottom:none;}
  .hstat:nth-child(4){border-right:none;border-bottom:none;}
  .hstat-v{font-size:28px;}
  .hstat-l{font-size:10px;}

  /* SECTIONS */
  .section{padding:56px 20px;}
  .divline{margin:0 20px;}
  h2.sec-title{letter-spacing:-1px;}
  .sec-body{font-size:15px;}

  /* PROCESS */
  .process-steps{grid-template-columns:1fr;}
  .ps{padding:24px 20px;}
  .ps-ico{width:52px;height:52px;font-size:22px;}

  /* ROLES */
  .roles-grid{grid-template-columns:1fr;}
  .role-card{padding:32px 24px;}
  .role-card:hover{transform:none;}

  /* MEETING */
  .mb-top{padding:24px 20px;flex-direction:column;align-items:flex-start;gap:12px;}
  .mb-top h3{font-size:17px;}
  .mb-flow{grid-template-columns:1fr;padding:24px 20px;gap:20px;}
  .mb-note{padding:20px;}
  .mbs{display:flex;align-items:flex-start;gap:16px;text-align:left;}
  .mbs-ico{flex-shrink:0;margin:0;}
  .mbs-content{flex:1;}
  html[dir="rtl"] .mbs{text-align:right;}

  /* REVENUE */
  .rev-grid{grid-template-columns:1fr;}
  .rev-main{grid-column:auto;}
  .rev-card{padding:28px 20px;}
  .inv-box{padding:28px 20px;gap:24px;}
  .inv-val{font-size:40px;}

  /* AI */
  .ai-features{grid-template-columns:1fr;}
  .aif{border-left:none;border-top:1px solid var(--border);}
  .aif:first-child{border-top:none;}
  .ai-head{padding:22px 20px;flex-direction:column;align-items:flex-start;gap:10px;}
  .ai-footer{padding:16px 20px;}

  /* ROADMAP */
  .roadmap{
    grid-template-columns:1fr;
    border-radius:16px;
  }
  .rm{border-right:none;border-bottom:1px solid var(--border);padding:28px 20px;}
  .rm:last-child{border-bottom:none;}
  .rm:nth-child(3){border-top:none;}

  /* MANIFESTO */
  .manifesto{padding:60px 20px;}
  .manifesto-watermark{font-size:100px;}
  .manifesto blockquote{letter-spacing:-0.5px;}
  .manifesto-sub{font-size:14px;}

  /* TECH */
  .tech-grid{grid-template-columns:1fr 1fr;gap:8px;}
  .tech-card{padding:14px 12px;gap:10px;}
  .tc-ico{font-size:20px;}
  .tc-name{font-size:12px;}
  .tc-role{font-size:10px;}

  /* CTA */
  .fcta{padding:60px 20px;}
  .fcta h2{letter-spacing:-2px;}
  .fcta p{font-size:15px;}
  .fcta-btns{flex-direction:column;gap:10px;}
  .fcta-btns button{width:100%;font-size:15px!important;padding:16px 24px!important;}

  /* FOOTER */
  footer{padding:40px 20px;}
  .f-logo{font-size:26px;}
  .f-tagline{font-size:13px;}

  /* TOUCH — larger tap targets */
  .lang-btn{padding:10px 16px;font-size:12px;}
  a,button{min-height:44px;display:inline-flex;align-items:center;justify-content:center;}
  .nav-burger{min-height:44px;min-width:44px;cursor:pointer!important;}
  .ps,.role-card,.rev-card,.tech-card{cursor:default!important;}

  /* Disable heavy 3D transforms on mobile */
  .role-card:hover,.ps:hover,.rev-card:hover{transform:none!important;}
}

/* ═══════════════════════════════════════
   RESPONSIVE — SMALL MOBILE 380px
═══════════════════════════════════════ */
@media(max-width:380px){
  .hero-tag{font-size:9px;letter-spacing:1.5px;padding:7px 12px;}
  h1.htitle{font-size:clamp(42px,12vw,60px);}
  .tech-grid{grid-template-columns:1fr;}
  .hero-stats{grid-template-columns:1fr 1fr;}
  .btn-primary,.btn-outline{font-size:14px;padding:14px 20px;}
}

/* ═══════════════════════════════════════
   AUTH — NAV ADDITIONS
═══════════════════════════════════════ */
#nav-join-btn{
  background:transparent;color:var(--gold2);
  font-family:var(--font-body-en);font-size:13px;font-weight:700;
  padding:9px 18px;border-radius:8px;
  border:1px solid var(--goldl);
  letter-spacing:.5px;transition:all .3s;white-space:nowrap;
}
#nav-join-btn:hover{background:var(--goldf);border-color:var(--gold);color:var(--gold);}
#nav-user-wrap{display:flex;align-items:center;gap:8px;}
#nav-user-name{
  font-size:13px;font-weight:600;color:var(--gold2);
  letter-spacing:.3px;max-width:120px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
#nav-logout-btn{
  font-size:12px;color:var(--dim);font-family:var(--font-body-en);
  background:none;border:none;padding:4px 8px;border-radius:6px;
  transition:color .2s;letter-spacing:.3px;
}
#nav-logout-btn:hover{color:var(--ember);}

/* ═══════════════════════════════════════
   MODAL OVERLAY & CARD
═══════════════════════════════════════ */
.modal-overlay{
  position:fixed;inset:0;z-index:800;
  background:rgba(2,4,10,.93);
  backdrop-filter:blur(30px);
  display:flex;align-items:center;justify-content:center;padding:20px;
  opacity:0;visibility:hidden;
  transition:opacity .3s ease,visibility .3s ease;
}
.modal-overlay.modal--open{opacity:1;visibility:visible;}
.modal-card{
  background:var(--surface);
  border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r3);padding:40px;
  width:100%;max-width:460px;
  position:relative;max-height:90vh;overflow-y:auto;
}
.modal-card--wide{max-width:540px;}
.modal-close{
  position:absolute;top:16px;right:20px;
  background:none;border:none;color:var(--dim);
  font-size:18px;width:32px;height:32px;
  display:flex;align-items:center;justify-content:center;
  border-radius:6px;transition:color .2s,background .2s;
}
.modal-close:hover{color:var(--white);background:var(--border);}
.modal-title{
  font-family:var(--font-en);font-size:24px;font-weight:700;
  color:var(--white);letter-spacing:-1px;margin-bottom:28px;
}

/* ═══════════════════════════════════════
   AUTH TABS
═══════════════════════════════════════ */
.modal-tabs{
  display:flex;gap:4px;margin-bottom:28px;
  background:var(--lift);border-radius:var(--r);padding:4px;
}
.modal-tab{
  flex:1;background:none;border:none;
  color:var(--dim);font-family:var(--font-body-en);
  font-size:13px;font-weight:600;padding:9px;border-radius:6px;
  transition:all .2s;letter-spacing:.3px;
}
.modal-tab--active{
  background:var(--surface);color:var(--gold2);
  box-shadow:0 1px 4px rgba(0,0,0,.3);
}

/* ═══════════════════════════════════════
   FORM FIELDS
═══════════════════════════════════════ */
.field-group{display:flex;flex-direction:column;gap:7px;margin-bottom:18px;}
.field-group label{
  font-size:11px;font-weight:700;color:var(--dim);
  letter-spacing:.8px;text-transform:uppercase;
}
.field-group input,
.field-group textarea,
.field-group select{
  background:var(--lift);
  border:1px solid var(--border);
  border-radius:var(--r);
  color:var(--white);font-family:var(--font-body-en);
  font-size:14px;padding:13px 16px;
  transition:border-color .2s;width:100%;
}
.field-group textarea{resize:vertical;min-height:120px;}
.field-group input:focus,
.field-group textarea:focus,
.field-group select:focus{outline:none;border-color:var(--gold);}
.field-group select{appearance:none;cursor:pointer;}
.field-group select option{background:var(--lift);}
.field-group input::placeholder,
.field-group textarea::placeholder{color:var(--dim);opacity:.6;}

/* ═══════════════════════════════════════
   ERROR / CONFIRM SLOTS
═══════════════════════════════════════ */
.error-slot{
  background:var(--emberf);
  border:1px solid rgba(255,56,32,.2);
  border-radius:var(--r);color:#ff6650;
  font-size:13px;padding:10px 14px;margin-bottom:14px;line-height:1.5;
}
.confirm-msg{
  background:rgba(59,143,255,.08);
  border:1px solid rgba(59,143,255,.2);
  border-radius:var(--r);color:var(--sky);
  font-size:13px;padding:14px 16px;
  text-align:center;line-height:1.65;margin-top:16px;
}
.role-gate{
  text-align:center;padding:28px 8px;
  color:var(--dim);font-size:14px;line-height:1.8;
}
.role-gate strong{color:var(--gold2);}

/* ═══════════════════════════════════════
   BUTTON LOADING STATE
═══════════════════════════════════════ */
.btn-primary.btn--loading,
.btn-outline.btn--loading{position:relative;color:transparent!important;pointer-events:none;}
.btn-primary.btn--loading::after,
.btn-outline.btn--loading::after{
  content:'';position:absolute;
  width:18px;height:18px;
  border:2px solid rgba(255,255,255,.25);
  border-top-color:rgba(255,255,255,.8);
  border-radius:50%;
  animation:spin .7s linear infinite;
  top:50%;left:50%;transform:translate(-50%,-50%);
}
@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg);}}

/* ═══════════════════════════════════════
   TOAST
═══════════════════════════════════════ */
#toast-container{
  position:fixed;bottom:32px;right:32px;z-index:950;
  display:flex;flex-direction:column;gap:10px;pointer-events:none;
}
.toast{
  background:var(--lift);border:1px solid var(--border);
  border-radius:var(--r2);color:var(--white);
  font-family:var(--font-body-en);font-size:14px;font-weight:500;
  padding:14px 20px;
  box-shadow:0 8px 32px rgba(0,0,0,.4);
  transform:translateY(16px);opacity:0;
  transition:transform .3s ease,opacity .3s ease;
  pointer-events:none;max-width:300px;word-break:break-word;
}
.toast--visible{opacity:1;transform:translateY(0);}
.toast--success{border-left:3px solid var(--gold);}
.toast--error{border-left:3px solid var(--ember);}
.toast--info{border-left:3px solid var(--sky);}

/* ═══════════════════════════════════════
   IDEAS FEED
═══════════════════════════════════════ */
#ideas-feed-section{padding:80px 60px;max-width:1240px;margin:0 auto;position:relative;z-index:1;}
#ideas-feed-list{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
  gap:24px;margin-top:40px;
}
.idea-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--r2);padding:28px;
  transition:border-color .3s,transform .3s;
}
.idea-card:hover{border-color:var(--goldl);transform:translateY(-4px);}
.idea-chip{
  display:inline-block;font-size:10px;font-weight:700;
  color:var(--ember);letter-spacing:3px;text-transform:uppercase;
  margin-bottom:12px;
}
.idea-title{
  font-family:var(--font-en);font-size:18px;font-weight:700;
  color:var(--gold2);letter-spacing:-.5px;
  margin-bottom:10px;line-height:1.3;
}
.idea-problem{
  font-size:13px;color:var(--dim);line-height:1.7;
  display:-webkit-box;-webkit-line-clamp:4;
  -webkit-box-orient:vertical;overflow:hidden;
}
.idea-skills{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;}
.skill-tag{
  font-size:11px;font-weight:600;color:var(--sky);letter-spacing:.5px;
  background:rgba(59,143,255,.08);border:1px solid rgba(59,143,255,.15);
  border-radius:20px;padding:3px 10px;
}
@media(max-width:520px){
  .modal-card{padding:28px 20px;}
  .modal-title{font-size:20px;}
  #ideas-feed-section{padding:60px 24px;}
  #toast-container{bottom:20px;right:16px;left:16px;}
  .toast{max-width:100%;}
}

/* ═══ NEXUS DASHBOARD VARS ════════════════════════════════════════════════ */
:root {
  --obsidian:       #0b0b0b;
  --obsidian-matte: #141414;
  --gold-vivid:     #d4af37;
  --fire:           #ff1e00;
  --fire-glow:      rgba(255,30,0,0.2);
  --ice-white:      #f5f5f5;
}

/* ═══ NEXUS DASHBOARD ═════════════════════════════════════════════════════ */

/* hero fades out when dashboard activates */
.hero { transition: opacity 0.3s ease; }
.hero--transitioning { opacity: 0; pointer-events: none; }

#nexus-dashboard {
  position: fixed;
  inset: 0;
  z-index: 400;
  background: var(--bg2);
  overflow-y: auto;
  padding-top: 80px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease 0.3s, visibility 0s linear 0.6s;
}
#nexus-dashboard.nexus--visible {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.3s ease, visibility 0s;
}

.nx-container {
  max-width: 960px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

.nx-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
#nx-title {
  font-family: var(--font-en);
  font-size: 22px;
  font-weight: 700;
  color: var(--gold-vivid);
  flex: 1;
}
#nx-user-role {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--gold2);
  background: rgba(212,175,55,0.1);
  border: 1px solid rgba(212,175,55,0.25);
  border-radius: 20px;
  padding: 4px 14px;
}
#nexus-refresh {
  background: transparent;
  border: 1px solid rgba(212,175,55,0.35);
  color: var(--gold2);
  border-radius: var(--r);
  padding: 8px 18px;
  font-size: 12px;
  font-weight: 700;
  font-family: var(--font-body-en);
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.25s;
}
#nexus-refresh:hover { border-color: var(--gold-vivid); color: var(--gold-vivid); }
#nexus-refresh:disabled { opacity: 0.4; cursor: not-allowed; }

/* glassmorphism cards */
.nx-card {
  background: rgba(20,20,20,0.55);
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  border: 1px solid rgba(212,175,55,0.18);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5), inset 0 1px 0 rgba(212,175,55,0.08);
  border-radius: var(--r2);
  padding: 24px;
  margin-bottom: 20px;
  transition: border-color 0.3s, box-shadow 0.3s;
}
.nx-card:hover {
  border-color: rgba(212,175,55,0.45);
  box-shadow: 0 8px 32px rgba(255,30,0,0.12), inset 0 1px 0 rgba(212,175,55,0.15);
}

/* match card layout */
.match-card { display: flex; gap: 20px; align-items: flex-start; }
.nx-match-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 56px;
}
.nx-score-num {
  font-family: var(--font-en);
  font-size: 28px;
  font-weight: 800;
  color: var(--gold-vivid);
  line-height: 1;
}
.nx-score-label { font-size: 10px; color: var(--gold2); letter-spacing: 1px; text-transform: uppercase; }
.nx-card-body { flex: 1; min-width: 0; }

/* idea card layout (visionary) */
.idea-card-nx { display: block; }
.nx-idea-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.nx-idea-meta { flex: 1; }
.nx-ring-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.nx-ring-label { font-size: 10px; color: var(--gold2); letter-spacing: 1px; text-transform: uppercase; }

/* SVG score ring */
.score-ring-track { stroke: rgba(212,175,55,0.15); }
.score-ring-fill {
  stroke: var(--gold-vivid);
  stroke-linecap: round;
  transition: stroke-dasharray 0.8s cubic-bezier(0.23,1,0.32,1);
}

/* shared typography */
.nx-idea-title {
  font-family: var(--font-en);
  font-size: 17px;
  font-weight: 700;
  color: var(--ice-white);
  margin: 0 0 8px;
}
.nx-chip {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--gold-vivid);
  background: rgba(212,175,55,0.1);
  border: 1px solid rgba(212,175,55,0.25);
  border-radius: 20px;
  padding: 3px 10px;
  margin-bottom: 10px;
}
.nx-idea-problem {
  font-size: 14px;
  color: var(--white);
  line-height: 1.6;
  margin: 0 0 12px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nx-skills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.nx-skill-tag {
  font-size: 11px;
  font-weight: 600;
  padding: 3px 10px;
  background: rgba(212,175,55,0.08);
  border: 1px solid rgba(212,175,55,0.2);
  border-radius: 20px;
  color: var(--gold2);
}

/* candidate info (visionary sub-cards) */
.match-card--candidate {
  padding: 14px 16px;
  display: flex;
  flex-direction: row;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.nx-candidate-info { flex: 1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.nx-candidate-name { font-size: 14px; font-weight: 700; color: var(--ice-white); }
.nx-match-score-small { display: flex; align-items: baseline; gap: 2px; }
.nx-score-num-small { font-family: var(--font-en); font-size: 20px; font-weight: 800; color: var(--gold-vivid); }
.nx-score-label-small { font-size: 11px; color: var(--gold2); }

/* idea matches sub-section */
.nx-idea-matches { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
.nx-matches-heading {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--gold2);
  margin: 0 0 12px;
}
.nx-no-matches { font-size: 13px; color: var(--gold2); opacity: 0.7; margin: 0; }

/* action buttons */
.nx-actions { display: flex; gap: 10px; margin-top: 14px; }
.btn-accept {
  background: transparent;
  border: 1px solid var(--gold-vivid);
  color: var(--gold-vivid);
  border-radius: var(--r);
  padding: 8px 18px;
  font-size: 12px;
  font-weight: 700;
  font-family: var(--font-body-en);
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.25s;
}
.btn-accept:hover { background: var(--gold-vivid); color: var(--obsidian); }
.btn-pass {
  background: transparent;
  border: 1px solid rgba(255,30,0,0.35);
  color: var(--ember);
  border-radius: var(--r);
  padding: 8px 18px;
  font-size: 12px;
  font-weight: 700;
  font-family: var(--font-body-en);
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.25s;
}
.btn-pass:hover { background: var(--fire-glow); border-color: var(--fire); }

/* status states */
.match-card--accepted { border-color: rgba(212,175,55,0.6) !important; }
.match-card--rejected { opacity: 0.4; pointer-events: none; }
.nx-status-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 20px;
  margin-top: 10px;
}
.nx-status--accepted { color: var(--gold-vivid); background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.25); }
.nx-status--rejected { color: var(--ember); background: rgba(255,56,32,0.08); border: 1px solid rgba(255,56,32,0.2); }

/* new match flash */
@keyframes gold-flash {
  0%,100% { box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
  50%      { box-shadow: 0 0 0 2px var(--gold-vivid), 0 8px 40px rgba(212,175,55,0.3); }
}
.nx-card--new { animation: gold-flash 1.2s ease; }

/* skeleton shimmer */
.nx-skeleton {
  background: linear-gradient(90deg, var(--lift) 25%, rgba(212,175,55,0.06) 50%, var(--lift) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: var(--r);
}
@keyframes shimmer { to { background-position: -200% 0; } }

/* empty state */
.nx-empty { text-align: center; padding: 80px 24px; }
.nx-empty-title { font-family: var(--font-en); font-size: 20px; font-weight: 700; color: var(--gold2); margin-bottom: 12px; }
.nx-empty-sub { font-size: 14px; color: var(--gold2); opacity: 0.6; }

/* error state */
.nx-error-state { text-align: center; padding: 60px 24px; }
.nx-error-msg { font-size: 15px; color: var(--ember); margin-bottom: 20px; }

@media(max-width:640px) {
  .match-card { flex-direction: column; gap: 12px; }
  .nx-idea-header { flex-direction: column; gap: 16px; }
  .nx-container { padding: 24px 16px 60px; }
}

/* ═══ LUXURY ASCENSION — font tokens + typographic scale ═══ */
:root {
  --font-en:       'Inter', 'SF Pro Display', -apple-system, 'Segoe UI', system-ui, sans-serif;
  --font-body-en:  'Inter', 'SF Pro Display', -apple-system, 'Segoe UI', system-ui, sans-serif;
  --font-ar:       'IBM Plex Sans Arabic', 'Noto Sans Arabic', 'Tajawal', system-ui, sans-serif;
  --font-mono:     'JetBrains Mono', 'SF Mono', Menlo, monospace;
  --fs-hero: clamp(2.75rem,5.5vw,4.5rem);
  --fs-h1:   clamp(2rem,3.5vw,2.75rem);
  --fs-h2:   clamp(1.5rem,2.5vw,2rem);
  --fs-h3:   1.25rem;
  --fs-body: 1rem;
  --fs-small: 0.8125rem;
  --fs-micro: 0.6875rem;
  --lh-tight: 1.1; --lh-snug: 1.35; --lh-relaxed: 1.65;
  --tracking-hero: -0.025em; --tracking-body: -0.005em; --tracking-eyebrow: 0.18em;
  --obsidian:       #0b0b0b;
  --obsidian-matte: #141414;
  --gold-vivid:     #d4af37;
  --fire:           #ff1e00;
  --fire-glow:      rgba(255,30,0,0.2);
  --ice-white:      #f5f5f5;
}
h1,h2,h3,h4{font-weight:600;letter-spacing:var(--tracking-hero);font-optical-sizing:auto;}
body{letter-spacing:var(--tracking-body);}
.sec-chip,.eyebrow-label{text-transform:uppercase;letter-spacing:var(--tracking-eyebrow);font-size:var(--fs-micro);}
.inv-val,.hstat-v,.nx-score-num,.score-num{font-variant-numeric:tabular-nums lining-nums;}

/* ═══ LANG PILLS ═══ */
.lang-pills{display:flex;gap:4px;align-items:center;}
.lang-pill{background:transparent;border:1px solid rgba(212,175,55,0.3);color:var(--gold2,#d0ba86);
  border-radius:20px;padding:4px 12px;font-size:11px;font-weight:600;letter-spacing:0.08em;
  cursor:pointer;transition:all 0.2s;font-family:var(--font-body-en);}
.lang-pill:hover{border-color:var(--gold-vivid);color:var(--gold-vivid);}
.lang-pill--active{background:var(--gold-vivid);border-color:var(--gold-vivid);color:#000;}

/* ═══ NAV SETTINGS BUTTON ═══ */
.nav-settings-btn{background:transparent;border:1px solid rgba(212,175,55,0.3);
  border-radius:8px;width:34px;height:34px;display:inline-flex;align-items:center;
  justify-content:center;cursor:pointer;transition:all 0.2s;color:var(--gold2,#d0ba86);}
.nav-settings-btn:hover{border-color:var(--gold-vivid);color:var(--gold-vivid);
  background:rgba(212,175,55,0.08);}

/* ═══ FOOTER LUXE ═══ */
.footer-luxe{text-align:center;padding:48px 24px 36px;border-top:1px solid rgba(212,175,55,0.12);}
.footer-luxe .f-logo{font-family:var(--font-en);font-size:1.25rem;font-weight:700;
  letter-spacing:-0.02em;margin-block-end:12px;}
.footer-tagline{font-size:var(--fs-small);color:var(--gold2,#d0ba86);margin-block-end:8px;}
.footer-sep{margin-inline:8px;opacity:0.4;}
.footer-meta{font-size:var(--fs-micro);color:rgba(255,255,255,0.3);letter-spacing:0.06em;}
.footer-dot{margin-inline:6px;}

/* ═══ TOAST ENHANCEMENTS ═══ */
.toast{display:flex;align-items:center;gap:8px;padding:12px 16px;border-radius:10px;
  background:var(--lift,#111827);border:1px solid rgba(212,175,55,0.2);
  box-shadow:0 8px 32px rgba(0,0,0,0.5);max-width:360px;
  opacity:0;transform:translateY(8px);transition:opacity 0.25s,transform 0.25s;pointer-events:none;}
.toast--visible{opacity:1;transform:translateY(0);pointer-events:auto;}
.toast--success{border-color:rgba(212,175,55,0.35);}
.toast--error{border-color:rgba(255,30,0,0.4);}
.toast--info{border-color:rgba(212,175,55,0.2);}
.toast-msg{flex:1;font-size:var(--fs-small);color:var(--ice-white,#f5f5f5);}
.toast-icon{flex-shrink:0;}
.toast-action{background:var(--gold-vivid,#d4af37);color:#000;border:none;
  border-radius:6px;padding:5px 12px;font-size:11px;font-weight:700;font-family:var(--font-body-en);
  letter-spacing:0.04em;cursor:pointer;white-space:nowrap;transition:opacity 0.2s;flex-shrink:0;}
.toast-action:hover{opacity:0.85;}
#toast-container{position:fixed;inset-block-end:24px;inset-inline-end:24px;
  z-index:9000;display:flex;flex-direction:column;gap:8px;align-items:flex-end;}

/* ═══ GLASS MODAL (settings <dialog>) ═══ */
dialog.glass-modal{
  position:fixed;inset:0;margin:auto;width:min(520px,92vw);max-height:90dvh;
  overflow-y:auto;background:rgba(14,14,20,0.92);
  backdrop-filter:blur(28px) saturate(160%);
  border:1px solid rgba(212,175,55,0.2);border-radius:var(--r2,16px);
  color:var(--white,#f5f5f5);padding:32px;
  box-shadow:0 24px 80px rgba(0,0,0,0.7),inset 0 1px 0 rgba(212,175,55,0.1);
  transition:opacity 0.2s;
}
dialog.glass-modal::backdrop{background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);}
dialog.glass-modal.glass-modal--closing{opacity:0;}
.glass-modal-header{display:flex;align-items:center;justify-content:space-between;margin-block-end:24px;}
.glass-modal-title{font-family:var(--font-en);font-size:1.25rem;font-weight:700;
  letter-spacing:var(--tracking-hero,-0.025em);}
.glass-modal-close{background:transparent;border:none;color:rgba(255,255,255,0.4);
  font-size:20px;cursor:pointer;padding:4px;line-height:1;transition:color 0.2s;}
.glass-modal-close:hover{color:var(--ice-white,#f5f5f5);}
/* Role picker cards */
.role-picker{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-block:16px;}
.role-card-label{cursor:pointer;}
.role-card-label input[type=radio]{position:absolute;opacity:0;pointer-events:none;}
.role-card-inner{
  border:1px solid rgba(212,175,55,0.18);border-radius:var(--r,8px);
  padding:14px 10px;text-align:center;transition:all 0.2s;
  background:rgba(20,20,20,0.4);
}
.role-card-label input[type=radio]:checked ~ .role-card-inner{
  border-color:var(--gold-vivid,#d4af37);
  background:rgba(212,175,55,0.1);
  box-shadow:0 0 0 1px var(--gold-vivid,#d4af37);
}
.role-card-inner:hover{border-color:rgba(212,175,55,0.4);}
.role-icon-wrap{display:flex;justify-content:center;margin-block-end:8px;}
.role-card-name{font-size:var(--fs-small);font-weight:600;color:var(--gold2,#d0ba86);}
.role-card-desc{font-size:10px;color:rgba(255,255,255,0.4);margin-block-start:4px;}
/* Skill chips */
.skill-chips-field{
  border:1px solid rgba(212,175,55,0.2);border-radius:var(--r,8px);
  padding:8px 10px;display:flex;flex-wrap:wrap;gap:6px;cursor:text;
  background:var(--lift,#111827);min-height:44px;transition:border-color 0.2s;
}
.skill-chips-field:focus-within{border-color:rgba(212,175,55,0.5);}
.skill-chip{display:inline-flex;align-items:center;gap:4px;background:rgba(212,175,55,0.12);
  border:1px solid rgba(212,175,55,0.3);border-radius:20px;
  padding:2px 10px 2px 10px;font-size:var(--fs-micro);color:var(--gold2,#d0ba86);}
.skill-chip-remove{background:none;border:none;color:rgba(255,255,255,0.4);
  cursor:pointer;font-size:14px;padding:0;line-height:1;transition:color 0.2s;}
.skill-chip-remove:hover{color:var(--ember,#ff3820);}
#settings-skills-input{background:transparent;border:none;outline:none;
  color:var(--white,#f5f5f5);font-size:var(--fs-small);font-family:var(--font-body-en);
  min-width:120px;flex:1;}
/* Buttons */
.btn-gold{background:var(--gold-vivid,#d4af37);color:#000;border:none;
  border-radius:var(--r,8px);padding:10px 24px;font-size:var(--fs-small);
  font-weight:700;font-family:var(--font-body-en);letter-spacing:0.04em;
  cursor:pointer;transition:opacity 0.2s;}
.btn-gold:hover{opacity:0.88;}
.btn-ghost{background:transparent;border:1px solid rgba(255,255,255,0.15);
  color:rgba(255,255,255,0.6);border-radius:var(--r,8px);padding:10px 24px;
  font-size:var(--fs-small);font-family:var(--font-body-en);cursor:pointer;transition:all 0.2s;}
.btn-ghost:hover{border-color:rgba(255,255,255,0.3);color:var(--white,#f5f5f5);}
.settings-actions{display:flex;gap:10px;justify-content:flex-end;margin-block-start:24px;}

/* ═══ OBSIDIAN POLISH — system defaults override + blue purge ═══ */
html{color-scheme:dark;accent-color:var(--gold-vivid,#d4af37);scrollbar-color:var(--gold-vivid,#d4af37) var(--obsidian,#0b0b0b);}
::selection{background:var(--gold-vivid,#d4af37);color:var(--obsidian,#0b0b0b);}
:focus-visible{outline:2px solid var(--gold-vivid,#d4af37);outline-offset:2px;}
input:-webkit-autofill,input:-webkit-autofill:hover,input:-webkit-autofill:focus,
textarea:-webkit-autofill,select:-webkit-autofill{
  -webkit-box-shadow:0 0 0 1000px var(--obsidian-matte,#141414) inset;
  -webkit-text-fill-color:var(--ice-white,#f5f5f5);
  caret-color:var(--gold-vivid,#d4af37);
  transition:background-color 9999s ease-in-out 0s;
}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-track{background:var(--obsidian,#0b0b0b);}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--gold-soft,#b8941f),var(--gold-vivid,#d4af37));border-radius:4px;}
a,a:visited{color:var(--gold-vivid,#d4af37);}
/* Token cascade: remap navy bg + blue accent tokens to obsidian/gold */
:root{
  --bg:      var(--obsidian,#0b0b0b);
  --bg2:     var(--obsidian-deeper,#050505);
  --surface: var(--obsidian-matte,#141414);
  --white:   var(--ice-white,#f5f5f5);
  --sky:     var(--gold-vivid,#d4af37);
  --dim:     rgba(245,245,245,0.45);
  --obsidian-deeper: #050505;
  --gold-bright:     #F4D77A;
  --gold-soft:       #B8941F;
  --fire-deep:       #C41600;
  --ice-dim:         rgba(245,245,245,0.62);
}
/* will-change — surgical (animated nodes only) */
#cur,#cur-ring,.glass-modal,.match-card,.toast{will-change:transform;}
/* Avatar zone */
.avatar-zone{display:flex;flex-direction:column;align-items:center;gap:12px;margin-block-end:20px;}
.avatar-circle{
  width:96px;height:96px;border-radius:50%;
  background:radial-gradient(circle at 30% 25%,#1f1f1f,var(--obsidian,#0b0b0b) 70%);
  border:2px solid var(--gold-vivid,#d4af37);
  box-shadow:0 0 0 1px rgba(212,175,55,0.25),0 8px 24px rgba(0,0,0,0.6),inset 0 1px 0 rgba(212,175,55,0.18);
  overflow:hidden;cursor:pointer;
  transition:transform .2s ease;display:flex;align-items:center;justify-content:center;
}
.avatar-circle:hover{transform:scale(1.03);}
.avatar-img{width:100%;height:100%;object-fit:cover;}
.avatar-placeholder{font-size:32px;color:rgba(212,175,55,0.4);line-height:1;user-select:none;}
.avatar-controls{display:flex;gap:8px;}
.avatar-controls button{
  background:transparent;border:1px solid rgba(212,175,55,0.25);
  color:var(--gold2,#d0ba86);border-radius:6px;padding:4px 10px;
  font-size:11px;font-family:var(--font-body-en);cursor:pointer;transition:all .2s;
}
.avatar-controls button:hover{border-color:var(--gold-vivid,#d4af37);color:var(--gold-vivid,#d4af37);}
/* Bio field */
.bio-field{margin-block-end:16px;}
.bio-field textarea{
  width:100%;resize:vertical;background:var(--lift,#111827);border:1px solid rgba(212,175,55,0.2);
  border-radius:var(--r,8px);padding:10px 12px;color:var(--ice-white,#f5f5f5);
  font-size:var(--fs-small);font-family:var(--font-body-en);transition:border-color .2s;
}
.bio-field textarea:focus{border-color:rgba(212,175,55,0.5);outline:none;}
.char-counter{font-size:10px;color:var(--ice-dim,rgba(245,245,245,0.62));margin-block-start:4px;display:block;}
</style>
</head>
<body>

<div id="cur"></div>
<div id="cur-ring"></div>

<div class="page-wrap">

