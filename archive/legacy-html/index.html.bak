    <div class="tech-card"><div class="tc-ico"><svg width="26" height="26" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="pc-rg" cx="33%" cy="28%" r="72%"><stop offset="0%" stop-color="#f5e0a0"/><stop offset="45%" stop-color="#D4A373"/><stop offset="100%" stop-color="#5a2a08"/></radialGradient><filter id="pc-f"><feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#D4A373" flood-opacity="0.5"/></filter></defs><circle cx="14" cy="14" r="11" fill="url(#pc-rg)" filter="url(#pc-f)"/><circle cx="14" cy="14" r="3" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="0.8"/><circle cx="14" cy="14" r="1.5" fill="rgba(255,255,255,0.45)"/><line x1="14" y1="3" x2="14" y2="11" stroke="rgba(255,255,255,0.35)" stroke-width="0.8"/><line x1="14" y1="17" x2="14" y2="25" stroke="rgba(255,255,255,0.35)" stroke-width="0.8"/><line x1="3" y1="14" x2="11" y2="14" stroke="rgba(255,255,255,0.35)" stroke-width="0.8"/><line x1="17" y1="14" x2="25" y2="14" stroke="rgba(255,255,255,0.35)" stroke-width="0.8"/><circle cx="14" cy="3" r="1.2" fill="rgba(255,255,255,0.45)"/><circle cx="25" cy="14" r="1.2" fill="rgba(255,255,255,0.45)"/><circle cx="3" cy="14" r="1.2" fill="rgba(255,255,255,0.45)"/><circle cx="14" cy="25" r="1.2" fill="rgba(255,255,255,0.45)"/><ellipse cx="10" cy="8" rx="2.5" ry="1.4" fill="rgba(255,255,255,0.18)" transform="rotate(-25 10 8)"/></svg></div><div><div class="tc-name">Pinecone / Chroma</div><div class="tc-role" data-en="AI Matching (Phase 2)" data-ar="مطابقة AI (المرحلة 2)">AI Matching (Phase 2)</div></div></div>
    <div class="tech-card"><div class="tc-ico"><svg width="26" height="26" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="gr-rg" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#f5e0a0"/><stop offset="50%" stop-color="#D4A373"/><stop offset="100%" stop-color="#7a4010"/></radialGradient><filter id="gr-f"><feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#D4A373" flood-opacity="0.45"/></filter></defs><g filter="url(#gr-f)"><path d="M14,5.5 L15.8,3 L17.6,5.5 L20.2,4.5 L20.2,7.2 L23,8 L22,10.5 L25,12.5 L22.5,15 L24,17.5 L21,19 L21,21.5 L18.2,21 L17,24 L14,22.5 L11,24 L9.8,21 L7,21.5 L7,19 L4,17.5 L5.5,15 L3,12.5 L6,10.5 L5,8 L7.8,7.2 L7.8,4.5 L10.4,5.5 Z" fill="url(#gr-rg)"/><circle cx="14" cy="14" r="4.5" fill="rgba(0,0,0,0.3)"/><circle cx="14" cy="14" r="2.5" fill="rgba(255,255,255,0.15)"/></g><ellipse cx="10" cy="8" rx="2.5" ry="1.5" fill="rgba(255,255,255,0.2)" transform="rotate(-30 10 8)"/></svg></div><div><div class="tc-name">Next.js</div><div class="tc-role" data-en="Full Platform (Phase 2)" data-ar="المنصة الكاملة (المرحلة 2)">Full Platform (Phase 2)</div></div></div>
  </div>
</div>

