<div class="fcta reveal">
  <h2 data-en="The Idea<br>Is <span>Ready.</span><br>Are You?" data-ar="الفكرة<br><span>جاهزة.</span><br>هل أنت؟">The Idea<br>Is <span>Ready.</span><br>Are You?</h2>
  <p data-en="UrLife is not another idea on your list. It's the platform that makes every other idea possible. The only decision left is to begin." data-ar="UrLife ليس فكرة أخرى على قائمتك. إنه المنصة التي تجعل كل فكرة أخرى ممكنة. القرار الوحيد المتبقي هو البدء.">UrLife is not another idea on your list. It's the platform that makes every other idea possible. The only decision left is to begin.</p>
  <div class="fcta-btns">
    <button id="cta-submit-btn" class="btn-primary" style="font-size:16px;padding:18px 52px;" data-en="Submit Your Idea Now" data-ar="قدّم فكرتك الآن">Submit Your Idea Now</button>
    <button class="btn-outline" style="font-size:16px;padding:18px 52px;" data-en="Request a Closed Meeting" data-ar="اطلب اجتماعاً مغلقاً">Request a Closed Meeting</button>
  </div>
</div>

<!-- ══════════ IDEAS FEED ══════════ -->
<section id="ideas-feed-section" hidden>
  <span class="sec-chip">Your Submitted Ideas</span>
  <h2 class="sec-title">Launched <span class="g">Ideas</span></h2>
  <div id="ideas-feed-list"></div>
</section>

<footer class="footer-luxe">
  <div class="f-logo"><span>UR LF <span style="color:#D4A373;">✘</span> <span style="color:#ef4444;">UP ™</span></span></div>
  <p class="footer-tagline">Where Minds Meet<span class="footer-sep">—</span>Zero Financial Barriers</p>
  <p class="footer-meta"><span>Global Platform</span><span class="footer-dot">·</span><span>AI-Powered</span></p>
</footer>

</div><!-- /page-wrap -->

<!-- ══════════ AUTH MODAL ══════════ -->
<div id="auth-modal" class="modal-overlay" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
    <button id="auth-modal-close" class="modal-close" aria-label="Close">✕</button>
    <div class="modal-tabs" role="tablist">
      <button id="auth-tab-login" class="modal-tab modal-tab--active" role="tab" aria-selected="true">Sign In</button>
      <button id="auth-tab-register" class="modal-tab" role="tab" aria-selected="false">Join Now</button>
    </div>

    <!-- Login panel -->
    <div id="auth-panel-login" role="tabpanel">
      <h2 class="modal-title" id="auth-modal-title">Welcome Back</h2>
      <form id="login-form" novalidate autocomplete="on">
        <div class="field-group">
          <label for="login-email">Email</label>
          <input type="email" id="login-email" name="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <div class="field-group">
          <label for="login-password">Password</label>
          <input type="password" id="login-password" name="password" autocomplete="current-password" placeholder="••••••••" required>
        </div>
        <div id="login-error" class="error-slot" hidden></div>
        <button type="submit" id="login-submit" class="btn-primary" style="width:100%;margin-top:4px;">Sign In</button>
      </form>
    </div>

    <!-- Register panel -->
    <div id="auth-panel-register" role="tabpanel" hidden>
      <h2 class="modal-title">Join UrLife</h2>
      <form id="register-form" novalidate autocomplete="on">
        <div class="field-group">
          <label for="register-name">Full Name</label>
          <input type="text" id="register-name" name="fullName" autocomplete="name" placeholder="Your full name" required>
        </div>
        <div class="field-group">
          <label for="register-email">Email</label>
          <input type="email" id="register-email" name="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <div class="field-group">
          <label for="register-password">Password</label>
          <input type="password" id="register-password" name="password" autocomplete="new-password" placeholder="Min 8 chars · letters + numbers" required>
        </div>
        <div class="field-group">
          <label for="register-role">Your Role</label>
          <select id="register-role" name="role" required>
            <option value="" disabled selected>Select your role</option>
            <option value="visionary">Visionary — I have an idea to build</option>
            <option value="builder">Builder — I build things</option>
            <option value="enabler">Enabler — I fund and enable</option>
          </select>
        </div>
        <div class="field-group">
          <label for="register-skills">Skills (comma-separated)</label>
          <input type="text" id="register-skills" name="skills" autocomplete="off" placeholder="e.g. design, react, marketing" required>
        </div>
        <div id="register-error" class="error-slot" hidden></div>
        <button type="submit" id="register-submit" class="btn-primary" style="width:100%;margin-top:4px;">Create Account</button>
      </form>
      <div id="register-confirm-msg" class="confirm-msg" hidden>
        Check your inbox — we sent you a confirmation link. Once verified, sign in above.
      </div>
    </div>
  </div>
</div>

<!-- ══════════ IDEA MODAL ══════════ -->
<div id="idea-modal" class="modal-overlay" aria-hidden="true">
  <div class="modal-card modal-card--wide" role="dialog" aria-modal="true" aria-labelledby="idea-modal-title">
    <button id="idea-modal-close" class="modal-close" aria-label="Close">✕</button>

    <div id="idea-role-gate" class="role-gate" hidden>
      <p>Only <strong>Visionaries</strong> can submit ideas.<br>Update your role in your profile to continue.</p>
    </div>

    <div id="idea-form-wrap">
      <h2 class="modal-title" id="idea-modal-title">Launch Your Idea</h2>
      <form id="idea-form" novalidate>
        <div class="field-group">
          <label for="idea-title">Idea Title</label>
          <input type="text" id="idea-title" name="title" maxlength="200" placeholder="What is your idea called?" required>
        </div>
        <div class="field-group">
          <label for="idea-industry">Industry</label>
          <input type="text" id="idea-industry" name="industry" maxlength="80" placeholder="e.g. FinTech, Healthcare, EdTech" required>
        </div>
        <div class="field-group">
          <label for="idea-problem">Problem It Solves</label>
          <textarea id="idea-problem" name="problem" maxlength="5000" placeholder="Describe the problem in detail (min 20 characters)..." required></textarea>
        </div>
        <div class="field-group">
          <label for="idea-skills">Skills Required (comma-separated, optional)</label>
          <input type="text" id="idea-skills" name="skills" autocomplete="off" placeholder="e.g. react, machine learning, finance">
        </div>
        <div id="idea-error" class="error-slot" hidden></div>
        <button type="submit" id="idea-submit" class="btn-primary" style="width:100%;margin-top:4px;">Launch Idea</button>
      </form>
    </div>
  </div>
</div>

<!-- ══════════ SETTINGS MODAL ══════════ -->
<dialog id="settings-modal" class="glass-modal" aria-labelledby="settings-modal-title">
  <div class="glass-modal-header">
    <h2 class="glass-modal-title" id="settings-modal-title">Account Settings</h2>
    <button id="settings-modal-close" class="glass-modal-close" aria-label="Close">✕</button>
  </div>
  <form id="settings-form" novalidate>
    <!-- Avatar zone -->
    <div id="settings-avatar-zone" class="avatar-zone" data-mode="empty">
      <div class="avatar-circle" role="img" aria-label="Profile photo">
        <img class="avatar-img" alt="" hidden>
        <span class="avatar-placeholder">+</span>
      </div>
      <div class="avatar-controls">
        <button type="button" data-action="upload">Upload</button>
        <button type="button" data-action="url">Paste URL</button>
        <button type="button" data-action="remove" hidden>Remove</button>
      </div>
      <input type="file" accept="image/png,image/jpeg,image/webp" hidden aria-hidden="true">
      <input type="url" placeholder="https://…" hidden aria-hidden="true" style="width:100%;margin-block-start:6px;background:var(--lift,#111827);border:1px solid rgba(212,175,55,0.2);border-radius:var(--r,8px);padding:8px 12px;color:var(--ice-white,#f5f5f5);font-size:var(--fs-small);font-family:var(--font-body-en);">
    </div>
    <div class="field-group">
      <label for="settings-name">Full Name</label>
      <input type="text" id="settings-name" name="full_name" autocomplete="name" placeholder="Your full name">
    </div>
    <div class="field-group" style="margin-block-start:20px;">
      <label>Your Role</label>
      <div class="role-picker">
        <label class="role-card-label" style="position:relative;">
          <input type="radio" name="role_type" value="visionary">
          <div class="role-card-inner">
            <div class="role-icon-wrap" id="role-icon-visionary"></div>
            <div class="role-card-name">Visionary</div>
            <div class="role-card-desc">Submit ideas</div>
          </div>
        </label>
        <label class="role-card-label" style="position:relative;">
          <input type="radio" name="role_type" value="builder">
          <div class="role-card-inner">
            <div class="role-icon-wrap" id="role-icon-builder"></div>
            <div class="role-card-name">Builder</div>
            <div class="role-card-desc">Build products</div>
          </div>
        </label>
        <label class="role-card-label" style="position:relative;">
          <input type="radio" name="role_type" value="enabler">
          <div class="role-card-inner">
            <div class="role-icon-wrap" id="role-icon-enabler"></div>
            <div class="role-card-name">Enabler</div>
            <div class="role-card-desc">Fund & connect</div>
          </div>
        </label>
      </div>
    </div>
    <div class="field-group" style="margin-block-start:20px;">
      <label>Skills</label>
      <div class="skill-chips-field" id="settings-skill-chips-wrap">
        <div id="settings-skill-chips" data-chips></div>
        <input type="text" id="settings-skills-input" placeholder="Type a skill, press Enter" autocomplete="off">
      </div>
    </div>
    <!-- Bio -->
    <div class="field-group bio-field" style="margin-block-start:16px;">
      <label for="settings-bio">Bio</label>
      <textarea id="settings-bio" name="bio" maxlength="160" rows="3" placeholder="Who are you, in one breath?"></textarea>
      <small class="char-counter" aria-live="polite"><span id="settings-bio-count">0</span> / 160</small>
    </div>
    <!-- Interests -->
    <div class="field-group" style="margin-block-start:16px;">
      <label>Interests</label>
      <div class="skill-chips-field" id="settings-interest-chips-wrap">
        <div id="settings-interest-chips" data-chips></div>
        <input type="text" id="settings-interests-input" placeholder="e.g. fintech, climate, web3" autocomplete="off">
      </div>
    </div>
    <div id="settings-error" class="error-slot" hidden></div>
    <div class="settings-actions">
      <button type="button" id="settings-cancel" class="btn-ghost">Cancel</button>
      <button type="submit" id="settings-submit" class="btn-gold">Save Changes</button>
    </div>
  </form>
</dialog>

<!-- ══════════ TOAST ══════════ -->
<div id="toast-container" aria-live="polite" aria-atomic="false"></div>

<script>
/* ═══ CUSTOM CURSOR — see /src/cursor.js ═══ */

/* ═══ SCROLL REVEAL ═══ */
const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');}});
},{threshold:.08});
document.querySelectorAll('.reveal,.reveal-scale').forEach(el=>obs.observe(el));

/* ═══ NAV SCROLL ═══ */
window.addEventListener('scroll',()=>{
  document.querySelector('nav').style.padding=window.scrollY>60?'12px 56px':'18px 56px';
});

/* ═══ LANGUAGE ═══ */
function setLang(lang){
  const isAR=lang==='ar';
  const html=document.getElementById('html-root');
  html.setAttribute('lang',lang);
  html.setAttribute('dir',isAR?'rtl':'ltr');
  document.title=isAR?'UrLife — حيث تلتقي العقول':'UrLife — Where Minds Meet';
  document.getElementById('lang-en')?.classList.toggle('lang-pill--active',!isAR);
  document.getElementById('lang-ar')?.classList.toggle('lang-pill--active',isAR);
  document.getElementById('lang-en')?.setAttribute('aria-pressed',String(!isAR));
  document.getElementById('lang-ar')?.setAttribute('aria-pressed',String(isAR));
  document.querySelectorAll('[data-en][data-ar]').forEach(el=>{
    const txt=isAR?el.getAttribute('data-ar'):el.getAttribute('data-en');
    if(txt) el.innerHTML=txt;
  });
  const hf=isAR?'var(--font-ar)':'var(--font-en)';
  document.querySelectorAll('h1,h2,h3,h4,.nav-logo,.f-logo').forEach(el=>el.style.fontFamily=hf);
  const pw=document.querySelector('.page-wrap');
  if(pw){pw.style.opacity='0';pw.style.transform='translateY(10px)';
    setTimeout(()=>{pw.style.transition='opacity .4s ease,transform .4s ease';
      pw.style.opacity='1';pw.style.transform='translateY(0)';},50);}
  localStorage.setItem('nexus_lang',lang);
}
document.getElementById('lang-en')?.addEventListener('click',()=>setLang('en'));
document.getElementById('lang-ar')?.addEventListener('click',()=>setLang('ar'));
const _sl=localStorage.getItem('nexus_lang');if(_sl&&_sl!=='en')setLang(_sl);

/* ═══ 3D CARD TILT ═══ */
document.querySelectorAll('.role-card,.ps,.rev-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const rect=card.getBoundingClientRect();
    const x=(e.clientX-rect.left)/rect.width-.5;
    const y=(e.clientY-rect.top)/rect.height-.5;
    card.style.transform=`perspective(800px) rotateY(${x*12}deg) rotateX(${-y*12}deg) translateY(-8px)`;
  });
  card.addEventListener('mouseleave',()=>{
    card.style.transform='';
  });
});

/* ═══ COUNTER ANIMATION ═══ */
function animCounter(el,target,suffix=''){
  let cur=0;const step=target/60;
  const t=setInterval(()=>{
    cur+=step;if(cur>=target){cur=target;clearInterval(t);}
    el.textContent=Math.round(cur)+suffix;
  },16);
}

/* ═══ SMOOTH ANCHOR ═══ */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    e.preventDefault();
    const t=document.querySelector(a.getAttribute('href'));
    if(t)t.scrollIntoView({behavior:'smooth',block:'start'});
  });
});
</script>
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js');
  }
</script>
<script type="module" src="/src/icons.js"></script>
<script type="module" src="/src/cursor.js"></script>
<script type="module" src="/src/settings.js"></script>
<script type="module" src="/src/main.js"></script>
<script type="module" src="/src/dashboard.js"></script>
</html>
