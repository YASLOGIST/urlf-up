</nav>

<!-- ══════════ HERO ══════════ -->
<section class="hero">
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>
  <div class="hero-rings">
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
    <div class="ring ring-3"></div>
  </div>

  <div class="hero-tag">
    <span class="dot"></span>
    <span data-en="Where Minds Build Empires" data-ar="حيث تبني العقول الإمبراطوريات">Where Minds Build Empires</span>
  </div>

  <h1 class="htitle">
    <span class="l1" data-en="Ideas Meet" data-ar="الأفكار">Ideas Meet</span>
    <span class="l2" data-en="People Meet" data-ar="تلتقي">People Meet</span>
    <span class="l3" data-en="Futures" data-ar="بالمستقبل">Futures</span>
  </h1>

  <p class="hero-desc">
    <span data-en="UrLife is not a social network. It's a <strong>project generation engine</strong> — where ambitious ideas meet the right people, get filtered by AI, and transform into real businesses. <strong>Zero financial barriers. 100% merit-based.</strong>" data-ar="UrLife ليست شبكة اجتماعية. إنه <strong>محرك توليد المشاريع</strong> — حيث تلتقي الأفكار الطموحة بالأشخاص المناسبين، تُفلتَر بالذكاء الاصطناعي، وتتحول إلى أعمال حقيقية. <strong>صفر حواجز مالية. 100% قائم على الجدارة.</strong>">UrLife is not a social network. It's a <strong>project generation engine</strong> — where ambitious ideas meet the right people, get filtered by AI, and transform into real businesses. <strong>Zero financial barriers. 100% merit-based.</strong></span>
  </p>

  <div class="hero-btns">
    <button id="hero-submit-btn" class="btn-primary" data-en="Submit Your Idea" data-ar="قدّم فكرتك">Submit Your Idea</button>
    <button class="btn-outline" data-en="Explore the Platform" data-ar="استكشف المنصة">Explore the Platform</button>
  </div>

  <div class="hero-stats">
    <div class="hstat">
      <span class="hstat-v">∞</span>
      <span class="hstat-l" data-en="Ideas Without Limits" data-ar="أفكار بلا سقف">Ideas Without Limits</span>
    </div>
    <div class="hstat">
      <span class="hstat-v">0</span>
      <span class="hstat-l" data-en="Financial Entry Barrier" data-ar="حاجز مالي للدخول">Financial Entry Barrier</span>
    </div>
    <div class="hstat">
      <span class="hstat-v">3</span>
      <span class="hstat-l" data-en="Mind Types, One Platform" data-ar="أنواع عقول، منصة واحدة">Mind Types, One Platform</span>
    </div>
    <div class="hstat">
      <span class="hstat-v">AI</span>
      <span class="hstat-l" data-en="Powered Matching Engine" data-ar="محرك مطابقة بالذكاء الاصطناعي">Powered Matching Engine</span>
    </div>
  </div>
</section>

<!-- ══════════ NEXUS DASHBOARD ══════════ -->
