{
  "name": "urlf-up",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "UrLife — Where Minds Meet. Vanilla-JS, zero-UI-framework marketing site and member console.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "measure": "node scripts/measure-bundle.mjs dist",
    "measure:baseline": "node scripts/measure-bundle.mjs .baseline/dist dist",
    "bench": "node scripts/bench-field.mjs",
    "audit": "node scripts/audit-high.mjs",
    "check:links": "node scripts/check-links.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/generate-og.mjs",
    "brand": "npm run icons && npm run og",
    "verify": "npm run lint && npm run test && npm run build && npm run measure && npm run audit:contrast && npm run audit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@supabase/supabase-js": "^2.105.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.3"
  }
}
